# Names of the environment variables this project uses. NO VALUES IN THIS FILE.
# Neither Claude Code nor Codex reads .env files, so set these in your environment
# (see README > Secrets). Copying this file to .env is fine for app code; .env is gitignored.

# GitHub MCP server: fine-grained PAT (selected repos; Issues RW, Pull requests RW, Contents R)
GITHUB_PAT=

# Context7 MCP server (up-to-date library docs). OPTIONAL: it works without a key, but a free
# key from https://context7.com gives higher rate limits. Keys start with "ctx7sk"; leave unset
# rather than setting a placeholder, because a wrong key makes every call fail.
CONTEXT7_API_KEY=

# Per-person agent options (Claude Code and Codex). Set to 1 to enable.
AGENT_NOTIFY=
AGENT_STOP_TESTS=
